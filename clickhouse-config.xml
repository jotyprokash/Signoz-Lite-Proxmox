<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <!-- Allow ClickHouse to use up to 70% of available memory (will use swap if needed) -->
    <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>
    <max_thread_pool_size>2</max_thread_pool_size>
    <max_io_thread_pool_size>2</max_io_thread_pool_size>
    
    <!-- Reduce cache sizes to save memory -->
    <uncompressed_cache_size>64000000</uncompressed_cache_size>
    <mark_cache_size>64000000</mark_cache_size>

    <profiles>
        <default>
            <!-- 800MB limit for a single query -->
            <max_memory_usage>800000000</max_memory_usage>
        </default>
    </profiles>
</clickhouse>
