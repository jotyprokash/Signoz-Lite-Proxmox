{
    local_certs
}

192.168.1.17 {
    basic_auth / {
        admin {$SIGNOZ_ADMIN_PASSWORD_HASH}
    }

    # Reverse proxy to the unified SigNoz service
    reverse_proxy signoz:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    log {
        output file /var/log/caddy/access.log
    }
}
