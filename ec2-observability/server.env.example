# Absolute path to the Docker Compose application on this EC2 host.
APP_DIR="/srv/example-application"
APP_COMPOSE_FILE="docker-compose.yml"

# Network key as declared under `networks:` in the application Compose model.
APP_NETWORK="application-network"

# Comma-separated compose-service=otel-service-name mappings.
OTEL_SERVICES="web=example-web"
SERVICE_NAMESPACE="example-namespace"
DEPLOYMENT_ENVIRONMENT="development"

# Private on-prem SigNoz collector address, normally reached through Tailscale.
SIGNOZ_OTLP_ENDPOINT="100.x.y.z:4317"

# Keep ten percent of traces. Use 1 only for a short validation window.
TRACE_SAMPLE_RATIO="0.10"
OTEL_IGNORED_PATHS="/health,/ready,/live,/metrics"

# Opt-in Docker stdout/stderr collection and bounded local retention.
ENABLE_DOCKER_LOGS="false"
DOCKER_LOG_MAX_SIZE="20m"
DOCKER_LOG_MAX_FILES="3"
DOCKER_SOCKET_PROXY_IMAGE="ghcr.io/tecnativa/docker-socket-proxy:v0.4.2"

INSTALL_ROOT="/opt/signoz-ec2-observability"
COLLECTOR_IMAGE="otel/opentelemetry-collector-contrib:0.153.0"
