# Defaults below match the current Saafir development EC2 host.
APP_DIR=/var/www/saafir/api.b2b.dev-saafir.jatritech.com
APP_COMPOSE_FILE=docker-compose.yml
APP_NETWORK=saafir-network

# Comma-separated compose-service=otel-service-name entries.
OTEL_SERVICES=api=saafir-dev-api
SERVICE_NAMESPACE=saafir
DEPLOYMENT_ENVIRONMENT=development

# On-prem SigNoz collector reachable through Tailscale.
SIGNOZ_OTLP_ENDPOINT=100.88.205.91:4317

# 0.10 keeps ten percent of ordinary traces at the SDK.
TRACE_SAMPLE_RATIO=0.10

INSTALL_ROOT=/opt/saafir-observability
COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.128.0
