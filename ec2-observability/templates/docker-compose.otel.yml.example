services:
  api:
    environment:
      NODE_OPTIONS: --require /otel-node/otel-bootstrap.js
      OTEL_SERVICE_NAME: saafir-dev-api
      OTEL_SERVICE_NAMESPACE: saafir
      OTEL_DEPLOYMENT_ENVIRONMENT: development
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4317
      OTEL_EXPORTER_OTLP_PROTOCOL: grpc
      OTEL_RESOURCE_ATTRIBUTES: deployment.environment=development,service.namespace=saafir,service.type=api,host.type=ec2,cloud.provider=aws
    volumes:
      - /opt/saafir-observability/node-auto:/otel-node:ro

