# Dashboard hostname.
# Internal-only example: monitor.infra.internal
# Cloudflare Tunnel example: signoz.example.com
SIGNOZ_DOMAIN=signoz.example.com

# Generated by setup.sh with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
SIGNOZ_ADMIN_PASSWORD_HASH=

# Generated by setup.sh with:
# openssl rand -hex 32
SIGNOZ_TOKENIZER_JWT_SECRET=

# Optional: Cloudflare Tunnel token.
# Required only when starting with: docker compose --profile cloudflare up -d
CLOUDFLARED_TOKEN=

# OTLP listener bind addresses on the Proxmox VM.
# Defaults are local-only so 4317/4318 are not exposed on LAN/public interfaces.
#
# For EC2 telemetry over Tailscale, set both to the Proxmox VM Tailscale IP:
# OTEL_GRPC_BIND=100.x.x.x
# OTEL_HTTP_BIND=100.x.x.x
#
# For LAN-only telemetry, set these to the VM LAN IP:
# OTEL_GRPC_BIND=192.168.1.17
# OTEL_HTTP_BIND=192.168.1.17
OTEL_GRPC_BIND=127.0.0.1
OTEL_HTTP_BIND=127.0.0.1
